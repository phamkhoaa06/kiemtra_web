@{
    var back = Context.Request.Path + Context.Request.QueryString;
    var path = Context.Request.Path.Value ?? "/";
    bool inCat = path.StartsWith("/Categories", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="@T.Code">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @T["app_title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
<header class="topbar">
    <div class="container d-flex align-items-center gap-4 flex-wrap">
        <a class="brand" asp-controller="Dishes" asp-action="Index">🍜 <span>@T["app_title"]</span></a>
        <nav class="d-flex gap-1 flex-grow-1">
            <a class="navlink @(inCat ? "" : "active")" asp-controller="Dishes" asp-action="Index">@T["nav_dishes"]</a>
            <a class="navlink @(inCat ? "active" : "")" asp-controller="Categories" asp-action="Index">@T["nav_categories"]</a>
        </nav>
        <div class="langswitch" role="group" aria-label="@T["language"]">
            <a class="@(T.Code == "en" ? "on" : "")" href="@Url.Action("Set", "Language", new { lang = "en", returnUrl = back })">English</a>
            <a class="@(T.Code == "vi" ? "on" : "")" href="@Url.Action("Set", "Language", new { lang = "vi", returnUrl = back })">Tiếng Việt</a>
        </div>
    </div>
</header>
<main class="container py-4">
    @if (TempData["Ok"] is string ok) { <div class="alert alert-success">@T[ok]</div> }
    @if (TempData["Err"] is string er) { <div class="alert alert-danger">@T[er]</div> }
    @RenderBody()
</main>
</body>
</html>
